# If you're running on docker you will need to restart the container to apply changes.
# docker compose down && docker compose up -d
#
# GHCR: compose pulls pre-built images from GitHub Container Registry. Set GHCR_OWNER (lowercase).
# If packages are private: docker login ghcr.io -u YOUR_USERNAME (password = PAT with read:packages).
# Or make packages public in GitHub → Packages → raceiot-* → Package settings → Public.
# GHCR_OWNER=michael4d45
# IMAGE_TAG=latest

APP_NAME="Music Quiz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# HTTP app origin (`php artisan serve` default: 8000). Reverb: REVERB_SERVER_PORT. Docker single port: adjust APP_PORT.
# Ngrok: set APP_SCHEME=https, HOST_NAME=your-subdomain.ngrok-free.app, APP_PORT=443 (or omit for 443).
APP_SCHEME=http
HOST_NAME=localhost
APP_PORT=8000

APP_URL=${APP_SCHEME}://${HOST_NAME}:${APP_PORT}
# APP_URL drives url() and tooling (e.g. Laravel Boost get-absolute-url). If the
# wrong port appears, run `php artisan config:clear` and ensure APP_PORT matches
# the HTTP server you use (e.g. 8000 for `php artisan serve`).

VITE_DEV_HOST=0.0.0.0
# Origin for Vite HMR / public/hot. Use APP_URL only when Nginx serves Vite on the same port as the app.
VITE_DEV_SERVER_URL=http://${HOST_NAME}:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_PORT_TEST=5433

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTEXT_LOG_HTTP_ENABLED=false
CONTEXT_LOG_HTTP_CAPTURE_HEADERS=false
CONTEXT_LOG_HTTP_CAPTURE_BODY=false
CONTEXT_LOG_REQUEST=false
CONTEXT_LOG_RESPONSE=false
CONTEXT_LOG_USER=false
CONTEXT_LOG_DB=false
CONTEXT_LOG_CACHE=false
CONTEXT_LOG_QUEUE=false
CONTEXT_LOG_MAIL=false
CONTEXT_LOG_REVERB=false
CONTEXT_LOG_SCHEDULE=false
CONTEXT_LOG_NOTIFICATIONS=false
CONTEXT_LOG_BROADCASTING=false

SHOULD_LOG_VALIDATION_ERRORS=true

GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# WebSocket process: `reverb:start` listens on REVERB_SERVER_PORT (default 8080).
REVERB_SERVER_PORT=8080
# Client (Echo) port: match REVERB_SERVER_PORT unless TLS/proxy puts WS on APP_PORT.
REVERB_HOST="${HOST_NAME}"
REVERB_PORT=${REVERB_SERVER_PORT}
REVERB_SCHEME="${APP_SCHEME}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
